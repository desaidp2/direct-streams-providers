FROM node:22-bookworm-slim

WORKDIR /app

# Install the optional browser engine and its matching Chromium runtime.
COPY package.json package-lock.json ./
RUN npm install --omit=dev --include=optional \
    && npx patchright install --with-deps chromium \
    && npm cache clean --force

COPY . .

ENV NODE_ENV=production
ENV PORT=10000
ENV CHALLENGE_BROWSER=patchright
ENV CHALLENGE_BROWSER_HEADLESS=1
ENV CHALLENGE_BROWSER_PROFILE=/tmp/dsp-challenge-browser

EXPOSE 10000

CMD ["node", "scripts/flystream-companion.js"]
