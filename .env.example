# ==============================================================================
# Direct Streams Providers - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and adjust the values for your setup:
#   cp .env.example .env
#
# DO NOT commit `.env` to version control. Keep your local IP addresses, ports,
# and private configuration secret.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER BINDING & PORT
# ------------------------------------------------------------------------------

# PORT
# - WHAT:  The TCP port on which the Stremio Add-on and Companion server listens.
# - WHY:   Enables multi-service coexistence on a single device (e.g. Raspberry Pi,
#          NAS, home server, or local development workstation).
# - WHERE: Loaded by `server.js` and `scripts/flystream-companion.js`.
# - WHEN:  Set if the default port 7070 conflicts with another service.
PORT=7070

# HOST
# - WHAT:  Network interface IP to bind the HTTP server to.
# - WHY:   `0.0.0.0` binds to all interfaces, allowing smart TVs (Android TV,
#          Apple TV), phones, and other local network clients to reach the server.
#          Set to `127.0.0.1` if you only want local machine access or behind a reverse proxy.
# - WHERE: Loaded by `server.js` and `scripts/flystream-companion.js`.
# - WHEN:  Change to `127.0.0.1` for local-only setups or loopback behind Caddy/Nginx.
HOST=0.0.0.0


# ------------------------------------------------------------------------------
# 2. FLYSTREAM CHALLENGE BROWSER (PATCHRIGHT / CHROMIUM)
# ------------------------------------------------------------------------------

# CHALLENGE_BROWSER
# - WHAT:  Enables or disables the stealth browser companion engine.
# - WHY:   FlyStream (flystream.net) is protected by Cloudflare and Anubis bot-detection
#          interstitials ("checking your browser", "making sure you're not a bot").
#          A standard Node.js `fetch` or QuickJS engine receives HTTP 403 Forbidden.
#          Enabling `patchright` or `chromium` loads an automated, stealth browser tab
#          that completes the JavaScript challenge, acquires valid session cookies,
#          and performs in-page fetches to `/api/streams`.
# - WHERE: Read by `server.js` and `src/host/chromium-challenge-browser.js`.
# - WHEN:  Set to `patchright` (preferred) or `chromium` on the server hosting the companion.
#          Set to `0` to disable the browser engine completely (e.g. on serverless workers).
CHALLENGE_BROWSER=patchright

# CHALLENGE_BROWSER_PATH
# - WHAT:  Path to the Chromium/Chrome executable.
# - WHY:   Different operating systems and distributions install Chromium at different
#          locations (e.g. `/usr/bin/chromium` on Debian/Raspberry Pi OS,
#          `/Applications/Google Chrome.app/...` on macOS).
# - WHERE: Used by `chromium.launchPersistentContext` in `src/host/chromium-challenge-browser.js`.
# - WHEN:  Leave empty to auto-detect system Chromium or Patchright's bundled browser;
#          set explicitly if your binary is in a custom path.
# CHALLENGE_BROWSER_PATH=/usr/bin/chromium

# CHALLENGE_BROWSER_PROFILE
# - WHAT:  Directory path where the browser stores its persistent profile, cookies, and local state.
# - WHY:   Retaining session cookies (`__ddg1_`, `techaro.lol-anubis-*`, `fs_seen2`) across
#          restarts prevents triggering challenges on every stream request, reducing resolution
#          time from ~15 seconds to <500 milliseconds.
# - WHERE: Read by `src/host/chromium-challenge-browser.js`. Defaults to `~/.config/dsp-challenge-browser`.
# - WHEN:  Set to an explicit directory if you want to store the profile in a custom persistent volume
#          or external SSD. Avoid `/tmp` on systems where tmpfs wipes files on reboot.
# CHALLENGE_BROWSER_PROFILE=/home/<user>/.config/dsp-challenge-browser

# CHALLENGE_BROWSER_HEADLESS
# - WHAT:  Toggle headless mode ("1" for headless, "0" for headed).
# - WHY:   Certain anti-bot challenge engines detect headless Chrome flags. With Patchright,
#          headless mode is stealth-patched. However, if running on a device with X11/Xwayland
#          (like Raspberry Pi desktop with `DISPLAY=:0`), running headed in the background
#          guarantees 100% challenge pass rates.
# - WHERE: Read by `src/host/chromium-challenge-browser.js`. Defaults to "0" if DISPLAY exists, else "1".
# - WHEN:  Set to "1" on headless servers without X11 or xvfb. Set to "0" when an X server is available.
# CHALLENGE_BROWSER_HEADLESS=0

# DISPLAY
# - WHAT:  X11 display identifier for headed browser execution.
# - WHY:   Allows Chromium to render to a background X11/Xwayland session on Linux servers
#          (such as Raspberry Pi OS with desktop or `xvfb-run`).
# - WHERE: Read by Chromium and `src/host/chromium-challenge-browser.js`.
# - WHEN:  Set to `:0` (or your X display) when running as a systemd service on a Linux desktop host.
# DISPLAY=:0


# ------------------------------------------------------------------------------
# 3. CLIENT COMPANION INTEGRATION (NUVIO TV & EMBEDDED QUICKJS)
# ------------------------------------------------------------------------------

# FLYSTREAM_COMPANION_URL
# - WHAT:  The base URL(s) of your self-hosted companion server.
# - WHY:   When the FlyStream provider runs client-side inside Nuvio TV (embedded QuickJS
#          on Android TV), it cannot run headless Chromium or Patchright locally.
#          By configuring `FLYSTREAM_COMPANION_URL`, Nuvio TV queries your companion server
#          over the local network (`http://<LAN_IP>:7070/companion/flystream`).
#          The companion resolves the streams, copies its active session cookies,
#          and returns the stream objects with `behaviorHints.proxyHeaders.request`
#          pre-configured for ExoPlayer.
# - WHERE: Evaluated by `src/flystream/flystream-api-streams.js` when running client-side.
# - WHEN:  Set in client environments or companion test suites. Supports comma-separated
#          URLs for fallback (e.g. `http://192.168.1.50:7070,http://127.0.0.1:7070`).
# FLYSTREAM_COMPANION_URL=http://192.168.1.50:7070


# ------------------------------------------------------------------------------
# 4. TIMEOUTS & RESILIENCE
# ------------------------------------------------------------------------------

# PROVIDER_DEADLINE_MS
# - WHAT:  Maximum execution deadline in milliseconds for any individual provider.
# - WHY:   Stremio and WuPlay routers aggregate streams across multiple providers
#          (7Movies, Movy, FlyStream). If one provider stalls, this deadline ensures
#          the overall HTTP response returns within a bounded window rather than hanging.
# - WHERE: Read by `src/stremio/router.js`. Defaults to 9000 (9 seconds).
# - WHEN:  Increase to `15000` on high-latency networks or slow Raspberry Pi hardware.
PROVIDER_DEADLINE_MS=9000
